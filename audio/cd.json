{"largada": [["largada_0.ogg", 2, 1.256, "Dale, largamos con todo."], ["largada_1.ogg", 2, 1.179, "Vamos, que se larga."], ["largada_2.ogg", 2, 1.461, "Arrancá fuerte, sin miedo."], ["largada_3.ogg", 2, 1.165, "A fondo desde el principio."], ["largada_4.ogg", 2, 1.772, "Agarrate, salimos a la guerra."], ["largada_5.ogg", 2, 1.182, "Primer cambio, vamos."], ["largada_6.ogg", 2, 1.354, "Largada limpia, metele."], ["largada_7.ogg", 2, 0.869, "No aflojes ahora."], ["largada_8.ogg", 2, 1.286, "Salimos con todo, dale."], ["largada_9.ogg", 2, 1.081, "Atento a los costados."], ["largada_10.ogg", 2, 0.916, "A la carga, piloto."], ["largada_11.ogg", 1, 1.588, "Buena largada, seguí así."], ["largada_12.ogg", 1, 1.464, "Perfecto, arrancamos bien."], ["largada_13.ogg", 2, 1.093, "Cuidado con el de al lado."], ["largada_14.ogg", 2, 1.211, "Espacio libre, acelerá."], ["largada_15.ogg", 2, 0.901, "Vamos por la punta."], ["largada_16.ogg", 1, 1.771, "Largada tranquila, administrá."], ["largada_17.ogg", 1, 1.439, "Todo listo, a correr."], ["largada_18.ogg", 2, 1.098, "Dale, que esto empieza."]], "rival_atras": [["rival_atras_0.ogg", 2, 1.128, "Tenés uno pegado atrás."], ["rival_atras_1.ogg", 2, 1.521, "Ojo el espejo, viene encima."], ["rival_atras_2.ogg", 2, 1.272, "Te está buscando el de atrás."], ["rival_atras_3.ogg", 2, 1.657, "Rival pegado, no te duermas."], ["rival_atras_4.ogg", 3, 1.175, "Viene fuerte por detrás."], ["rival_atras_5.ogg", 2, 1.664, "Cuidado, lo tenés en el espejo."], ["rival_atras_6.ogg", 2, 0.955, "No le dejes el hueco."], ["rival_atras_7.ogg", 1, 0.914, "Te sigue de cerca."], ["rival_atras_8.ogg", 2, 1.406, "Atento, viene a chocarte."], ["rival_atras_9.ogg", 2, 0.988, "Pegado al paragolpes."], ["rival_atras_10.ogg", 2, 1.088, "No te desconcentres."], ["rival_atras_11.ogg", 2, 1.713, "Viene lanzado, cerrá la puerta."], ["rival_atras_12.ogg", 3, 1.511, "Lo tenés encima, aguantá."], ["rival_atras_13.ogg", 2, 1.647, "Rival atrás, mantené la línea."], ["rival_atras_14.ogg", 2, 0.905, "No frenes de golpe."], ["rival_atras_15.ogg", 2, 0.945, "Te está presionando."], ["rival_atras_16.ogg", 2, 1.194, "Viene por el lado interno."], ["rival_atras_17.ogg", 2, 1.244, "Cuidado con el contacto."], ["rival_atras_18.ogg", 1, 0.892, "Te sigue como sombra."], ["rival_atras_19.ogg", 2, 1.418, "No le regales la posición."], ["rival_atras_20.ogg", 2, 1.537, "Aguantá ahí, falta poco."], ["rival_atras_21.ogg", 2, 2.011, "Viene caliente, no lo dejes pasar."], ["rival_atras_22.ogg", 3, 0.845, "Espejo, espejo."], ["rival_atras_23.ogg", 2, 0.973, "Te está oliendo la nuca."], ["rival_atras_24.ogg", 2, 1.191, "Firme, que no te pase."]], "rival_izquierda": [["rival_izquierda_0.ogg", 2, 0.961, "Uno por la izquierda."], ["rival_izquierda_1.ogg", 2, 1.276, "Rival a tu izquierda."], ["rival_izquierda_2.ogg", 3, 1.334, "Viene por la izquierda, ojo."], ["rival_izquierda_3.ogg", 2, 1.21, "Izquierda, se asoma."], ["rival_izquierda_4.ogg", 2, 1.262, "Tenés uno al lado izquierdo."], ["rival_izquierda_5.ogg", 3, 0.954, "Cuidado a la izquierda."], ["rival_izquierda_6.ogg", 2, 1.039, "Se mete por izquierda."], ["rival_izquierda_7.ogg", 2, 1.434, "Rival izquierdo, cerrá."], ["rival_izquierda_8.ogg", 2, 0.9, "No le dejes el lugar."], ["rival_izquierda_9.ogg", 2, 1.273, "Viene pegado a tu izquierda."], ["rival_izquierda_10.ogg", 2, 1.322, "Atento al flanco izquierdo."], ["rival_izquierda_11.ogg", 1, 1.583, "Izquierda libre, pero viene."], ["rival_izquierda_12.ogg", 2, 1.268, "Se acerca por tu izquierda."], ["rival_izquierda_13.ogg", 2, 0.939, "No lo dejes entrar."], ["rival_izquierda_14.ogg", 3, 1.148, "Ojo, izquierda."]], "rival_derecha": [["rival_derecha_0.ogg", 2, 0.755, "Uno por la derecha."], ["rival_derecha_1.ogg", 2, 1.017, "Rival a tu derecha."], ["rival_derecha_2.ogg", 3, 1.319, "Viene por la derecha, ojo."], ["rival_derecha_3.ogg", 2, 0.981, "Derecha, se asoma."], ["rival_derecha_4.ogg", 2, 1.371, "Tenés uno al lado derecho."], ["rival_derecha_5.ogg", 3, 0.853, "Cuidado a la derecha."], ["rival_derecha_6.ogg", 2, 1.041, "Se mete por derecha."], ["rival_derecha_7.ogg", 2, 1.151, "Rival derecho, cerrá."], ["rival_derecha_8.ogg", 2, 0.871, "No le dejes el lugar."], ["rival_derecha_9.ogg", 2, 1.205, "Viene pegado a tu derecha."], ["rival_derecha_10.ogg", 2, 1.243, "Atento al flanco derecho."], ["rival_derecha_11.ogg", 1, 1.141, "Derecha libre, pero viene."], ["rival_derecha_12.ogg", 2, 1.125, "Se acerca por tu derecha."], ["rival_derecha_13.ogg", 2, 0.903, "No lo dejes entrar."], ["rival_derecha_14.ogg", 3, 0.983, "Ojo, derecha."]], "nos_pasaron": [["nos_pasaron_0.ogg", 2, 1.547, "Nos pasaron, no aflojes."], ["nos_pasaron_1.ogg", 2, 1.484, "Perdimos una, a recuperar."], ["nos_pasaron_2.ogg", 2, 0.717, "Se nos fue uno."], ["nos_pasaron_3.ogg", 2, 1.019, "Nos sacaron un lugar."], ["nos_pasaron_4.ogg", 2, 1.159, "Quedamos atrás, metele."], ["nos_pasaron_5.ogg", 2, 0.915, "Nos pasó el rival."], ["nos_pasaron_6.ogg", 2, 0.999, "Perdimos la posición."], ["nos_pasaron_7.ogg", 2, 1.288, "Nos superaron, vamos."], ["nos_pasaron_8.ogg", 2, 1.474, "Se nos escapó, dale."], ["nos_pasaron_9.ogg", 2, 1.321, "A recuperar ese lugar."], ["nos_pasaron_10.ogg", 2, 1.002, "Nos pasaron por afuera."], ["nos_pasaron_11.ogg", 2, 0.912, "Nos ganaron de mano."], ["nos_pasaron_12.ogg", 2, 1.816, "Nos ganaron la posición, reaccioná."], ["nos_pasaron_13.ogg", 2, 1.539, "Se nos vino encima y pasó."], ["nos_pasaron_14.ogg", 1, 1.47, "No era nuestro, a buscarlo."], ["nos_pasaron_15.ogg", 2, 1.257, "Nos dejó atrás, seguilo."], ["nos_pasaron_16.ogg", 2, 1.39, "Perdimos un puesto, vamos."], ["nos_pasaron_17.ogg", 1, 0.993, "Nos pasaron limpio."], ["nos_pasaron_18.ogg", 2, 1.666, "Se nos fue, no lo pierdas."], ["nos_pasaron_19.ogg", 2, 0.943, "A la carga de nuevo."]], "pasamos_rival": [["pasamos_rival_0.ogg", 2, 0.975, "Bien, los pasamos."], ["pasamos_rival_1.ogg", 2, 0.836, "Uno menos, vamos."], ["pasamos_rival_2.ogg", 2, 0.855, "Lo dejamos atrás."], ["pasam