os_cuartos_7.ogg", 2, 0.993, "Cuarto, a atacar."]], "vamos_quintos": [["vamos_quintos_0.ogg", 2, 1.399, "Vamos quintos, a remontar."], ["vamos_quintos_1.ogg", 2, 1.007, "Quinto puesto, metele."], ["vamos_quintos_2.ogg", 2, 1.327, "Estamos quintos, dale."], ["vamos_quintos_3.ogg", 2, 1.131, "Quinto, no aflojes."], ["vamos_quintos_4.ogg", 2, 1.195, "Vamos quintos, cerca."], ["vamos_quintos_5.ogg", 1, 1.063, "Quinto lugar, seguí."], ["vamos_quintos_6.ogg", 2, 1.482, "Estamos quintos, vamos."], ["vamos_quintos_7.ogg", 2, 1.043, "Quinto, a atacar."]], "vamos_ultimos": [["vamos_ultimos_0.ogg", 3, 1.284, "Vamos últimos, reaccioná."], ["vamos_ultimos_1.ogg", 2, 1.257, "Últimos, a remontar."], ["vamos_ultimos_2.ogg", 2, 1.133, "Estamos atrás de todos."], ["vamos_ultimos_3.ogg", 2, 1.377, "Último puesto, dale."], ["vamos_ultimos_4.ogg", 2, 1.459, "Vamos últimos, no aflojes."], ["vamos_ultimos_5.ogg", 2, 1.122, "Hay que remontar, vamos."], ["vamos_ultimos_6.ogg", 2, 1.066, "Últimos, metele."], ["vamos_ultimos_7.ogg", 2, 1.501, "Estamos últimos, a la carga."], ["vamos_ultimos_8.ogg", 1, 1.351, "Último, pero no vencido."], ["vamos_ultimos_9.ogg", 2, 1.295, "Vamos últimos, aguantá."], ["vamos_ultimos_10.ogg", 2, 1.33, "Hay tiempo, remontemos."], ["vamos_ultimos_11.ogg", 2, 1.502, "Últimos, dale que se puede."]], "primero_con_ventaja": [["primero_con_ventaja_0.ogg", 1, 1.079, "Primeros y con ventaja."], ["primero_con_ventaja_1.ogg", 1, 1.548, "Vamos punteros, tranquilos."], ["primero_con_ventaja_2.ogg", 1, 1.69, "Gran diferencia, administrá."], ["primero_con_ventaja_3.ogg", 2, 1.501, "Punta clara, no aflojes."], ["primero_con_ventaja_4.ogg", 1, 1.516, "Ventaja enorme, seguí así."], ["primero_con_ventaja_5.ogg", 1, 0.843, "Solos en la punta."], ["primero_con_ventaja_6.ogg", 1, 0.942, "Nadie nos alcanza."], ["primero_con_ventaja_7.ogg", 1, 1.415, "Vamos primeros, cómodos."], ["primero_con_ventaja_8.ogg", 2, 1.28, "Ventaja grande, cuidala."], ["primero_con_ventaja_9.ogg", 1, 1.317, "