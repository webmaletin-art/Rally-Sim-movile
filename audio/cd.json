a se puede."], ["animo_1.ogg", 2, 0.984, "No aflojes, piloto."], ["animo_2.ogg", 2, 0.695, "Levantá cabeza."], ["animo_3.ogg", 2, 1.295, "Falta poco, aguantá."], ["animo_4.ogg", 2, 1.238, "Sos rápido, dale."], ["animo_5.ogg", 2, 0.831, "Confío en vos."], ["animo_6.ogg", 2, 1.035, "A remontar, vamos."], ["animo_7.ogg", 2, 0.688, "No es el final."], ["animo_8.ogg", 2, 0.779, "Metele ganas."], ["animo_9.ogg", 2, 0.767, "Podés con esto."], ["animo_10.ogg", 2, 1.02, "Vamos por la revancha."], ["animo_11.ogg", 2, 1.068, "No bajes los brazos."], ["animo_12.ogg", 2, 0.579, "Todo se puede."], ["animo_13.ogg", 2, 0.7, "Dale, que sí."], ["animo_14.ogg", 2, 1.1, "Vamos arriba, piloto."]]}