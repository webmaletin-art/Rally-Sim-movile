nto delicado."], ["estacionar_despacio_5.ogg", 2, 1.077, "Sin apuro, piloto."], ["estacionar_despacio_6.ogg", 2, 0.869, "Cuidado al estacionar."], ["estacionar_despacio_7.ogg", 2, 0.926, "Despacio, dale."]], "cartel_roto": [["cartel_roto_0.ogg", 2, 0.678, "Cartel roto."], ["cartel_roto_1.ogg", 2, 0.991, "Rompimos un cartel."], ["cartel_roto_2.ogg", 2, 0.735, "Cartel afuera."], ["cartel_roto_3.ogg", 2, 0.617, "Uno menos."], ["cartel_roto_4.ogg", 2, 0.848, "Cartel destruido."], ["cartel_roto_5.ogg", 2, 1.014, "Buen golpe al cartel."], ["cartel_roto_6.ogg", 2, 0.768, "Cartel caído."], ["cartel_roto_7.ogg", 2, 0.91, "Rompiste el cartel."], ["cartel_roto_8.ogg", 2, 0.767, "Cartel hecho pedazos."], ["cartel_roto_9.ogg", 2, 1.066, "Otro cartel menos."]], "charla_recta": [["charla_recta_0.ogg", 1, 1.273, "Linda recta, piloto."], ["charla_recta_1.ogg", 1, 0.999, "A disfrutar el paisaje."], ["charla_recta_2.ogg", 1, 0.823, "Tranquilo por ahora."], ["charla_recta_3.ogg", 1, 1.105, "Buen ritmo, seguí."], ["charla_recta_4.ogg", 1, 0.927, "Esto se pone lindo."], ["charla_recta_5.ogg", 1, 0.767, "A respirar un poco."], ["charla_recta_6.ogg", 1, 0.864, "Vamos bien, che."], ["charla_recta_7.ogg", 1, 0.977, "No hay rival cerca."], ["charla_recta_8.ogg", 1, 0.942, "Buen día para correr."], ["charla_recta_9.ogg", 1, 0.893, "Se siente el motor."], ["charla_recta_10.ogg", 1, 0.937, "Todo bajo control."], ["charla_recta_11.ogg", 1, 0.831, "Recta tranquila."], ["charla_recta_12.ogg", 1, 1.037, "Podés relajarte."], ["charla_recta_13.ogg", 1, 1.099, "Buen trabajo hasta ahora."], ["charla_recta_14.ogg", 1, 1.037, "Seguí así, piloto."], ["charla_recta_15.ogg", 1, 0.968, "Me gusta este tramo."], ["charla_recta_16.ogg", 1, 0.945, "Vamos con calma."], ["charla_recta_17.ogg", 1, 1.106, "El auto responde bien."], ["charla_recta_18.ogg", 1, 0.896, "Buen sonido el motor."], ["charla_recta_19.ogg", 1, 1.311, "Vamos derecho, nomás."], ["charla_recta_20.ogg", 1, 1.039, "A mantener el ritmo."], ["charla_