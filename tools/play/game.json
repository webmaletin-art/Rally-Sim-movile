    "delete_account_url": "https://webmaletin-art.github.io/Rally-Sim-movile/docs/eliminar-cuenta.html"
  },
  "products": {
    "_nota": "IDs EXACTOS que se crean en Play Console (Monetizar → Productos → Productos integrados). kind: unlock = no consumible · credits = consumible. Precios en USD recomendados (docs/PLAY_STORE.md).",
    "dr_full": {"kind": "unlock", "usd": 9.99},
    "dr_adventure": {"kind": "unlock", "usd": 4.99},
