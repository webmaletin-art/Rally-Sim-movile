; Proyecto Godot de GSkorp Rally (versión Godot del juego).
; APK liviano: solo lleva el motor + res://bootstrap. El resto (res://game) se descarga como content.pck.
config_version=5

[application]

config/name="GSkorp Rally"
run/main_scene="res://bootstrap/boot.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/version="0.1"
boot_splash/show_image=false
boot_splash/bg_color=Color(0.039, 0.047, 0.078, 1)

[display]

window/size/viewport_width=1280
window/size/viewport_height=576
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[importer_defaults]

; Los .wav (sólo las 23 muestras de godot/game/audio/samples) se guardan SIN comprimir: los .import no se suben al repositorio (godot/.gitignore), así que esto es lo que
; decide el formato en la compilación. Las tablas cortas (seno, motor de 1050 muestras) y los bucles de ruido suenan igual de limpios y no gastan procesador en descomprimir.
wav={
"compress/mode": 0
}

[input_devices]

sensors/enable_accelerometer=true
sensors/enable_gravity=true

[physics]

common/physics_ticks_per_second=120
common/max_physics_steps_per_frame=6

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
mesh_lod/lod_change/threshold_pixels=2.0
lights_and_shadows/directional_shadow/size.mobile=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.mobile=1
environment/defaults/default_clear_color=Color(0.05, 0.07, 0.1, 1)

[autoload]

CrashGuard="*res://bootstrap/crash_guard.gd"

[debug]

file_logging/enable_file_logging=true
file_logging/max_log_files=6
